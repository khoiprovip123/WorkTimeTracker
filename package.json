{
  "name": "KTimeTracker",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "migrate:sync": "node scripts/sync-migrations.mjs",
    "dev": "npm run version:sync && node scripts/sync-migrations.mjs && vite",
    "build": "npm run version:sync && node scripts/sync-migrations.mjs && tsc -b && vite build",
    "build:linux": "npm run build && tauri build",
    "build:windows": "npm run build && tauri build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
